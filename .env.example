# PhishGuard Live Environment Configuration
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=change-me-to-a-secure-random-string-at-least-32-chars
PORT=5000

# Database Configuration
# Local SQLite fallback: sqlite:///phishguard.db
# Cloud PostgreSQL: postgresql://phishguard_user:password@hostname:5432/phishguard
DATABASE_URL=sqlite:///phishguard.db

# Rate Limiter
RATELIMIT_DEFAULT=100/minute
RATELIMIT_STORAGE_URI=memory://

# Security Admin Seed (optional initial admin credentials)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@phishguard.live
ADMIN_PASSWORD=AdminSecurePass2026!
